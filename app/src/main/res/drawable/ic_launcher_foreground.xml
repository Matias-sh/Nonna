<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Cubo 3D outline - forma original pero más grande para llenar el círculo -->
    <!-- Escalado desde el centro para mantener proporciones -->
    <group
        android:translateX="12"
        android:translateY="12"
        android:scaleX="1.5"
        android:scaleY="1.5"
        android:pivotX="42"
        android:pivotY="42">
        
        <!-- Cubo 3D isométrico - solo outline blanco -->
        <!-- Cara frontal (rectángulo) -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4"
            android:pathData="M12,30 L48,12 L48,48 L12,66 Z"/>
        
        <!-- Cara superior (paralelogramo) -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4"
            android:pathData="M12,30 L48,12 L66,30 L30,48 Z"/>
        
        <!-- Cara derecha (paralelogramo) -->
    <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4"
            android:pathData="M48,12 L66,30 L66,66 L48,48 Z"/>
    </group>
</vector>
